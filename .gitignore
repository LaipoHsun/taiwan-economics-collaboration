# Public release allowlist: everything else stays local.
/*
!/.gitignore
!/README.md
!/index.html
!/code/
/code/*
!/code/pipeline.py
!/html/
/html/*
!/html/map_explorer.html

# Never publish standalone datasets, caches, credentials or local state.
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.pkl
*.pickle
*.sqlite*
*.db
*.geojson
*.jsonl
*.pdf
*.zip
*.log
.env
.env.*
.openalex_key
*.pem
*.key
.DS_Store
.Rhistory
__pycache__/
*.py[cod]
.venv/
venv/
cache/
raw_data/
raw_html/
manual_review/
.local-backup/
.claude/
.codex/
.agents/
